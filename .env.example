# Server
HOST=0.0.0.0
PORT=8000

# Secrets — generate your own with `openssl rand -base64 32`, never reuse across environments
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=

# Database (Supabase PostgreSQL — single connection string)
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_SCHEMA=public
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Cloudinary (media storage)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=